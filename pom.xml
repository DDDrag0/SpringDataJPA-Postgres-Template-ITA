<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!--
		====================================================================================
		SPRING BOOT STARTER PARENT
		====================================================================================
		Funge da configurazione di base ereditata. Definisce la versione di riferimento di
		Spring Boot (3.1.0) e centralizza la gestione delle versioni per tutte le dipendenze
		compatibili, evitando conflitti di librerie (Dependency Management).
		====================================================================================
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<!--
		====================================================================================
		METADATI DEL PROGETTO (GAV)
		====================================================================================
		Identificativi univoci Maven per localizzare e identificare questo specifico progetto.
		====================================================================================
	-->
	<groupId>com.devtiro</groupId>
	<artifactId>database</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>database</name>
	<description>Spring Boot 3 REST API with JPA/Hibernate, PostgreSQL and DTO mapping via ModelMapper.</description>
	<!--
		====================================================================================
		PROPRIETÀ GLOBALI
		====================================================================================
		Definisce costanti di configurazione riutilizzabili. Qui dichiariamo l'adozione
		di Java 17 come linguaggio sorgente e target di compilazione.
		====================================================================================
	-->
	<properties>
		<java.version>17</java.version>
		<!--
		Queste righe servono per poter codificare i caratteri speciali immessi nei file come
		application.properties esistenti in questa repository per via della documentazione
		-->
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

	</properties>
	<!--
		====================================================================================
		GESTIONE DELLE DIPENDENZE (Dependencies)
		====================================================================================
		Dichiara i componenti esterni necessari compilati e gestiti automaticamente da Maven.
		====================================================================================
	-->
	<dependencies>
		<!--
		Spring Boot Starter Web:
		Fornisce tutti gli strumenti necessari per implementare l'architettura RESTful
		(MVC, Jackson, REST Controllers) e incorpora il server Web Tomcat su porta 8080.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!--
		Spring Boot Starter Data JPA:
		Include Hibernate e le astrazioni dei Repository per automatizzare l'interazione
		con il database ad oggetti tramite annotazioni ed entity JPA.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!--
		PostgreSQL Driver:
		Il driver JDBC runtime richiesto per consentire la comunicazione tra il codice
		Java dell'applicazione e l'istanza fisica del database PostgreSQL.
		-->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!--
		Lombok:
		Libreria di utilità che interviene in fase di compilazione per iniettare getter,
		setter, costruttori e pattern Builder, riducendo a zero il codice boilerplate.
		-->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>1.18.30</version> <!-- FORZA LA VERSIONE COMPATIBILE CON JAVA 17 -->
			<optional>true</optional>
		</dependency>
		<!--
		ModelMapper (v3.0.0):
		Libreria utilizzata per automatizzare la mappatura bidirezionale complessa tra
		le classi Entità del database e i DTO dello strato di presentazione.
		Da tenere a mente che in ambito enterprise si sta spostando tutto su MapStruct
		(che genera codice in compilazione, senza reflection, quindi molto più performante).
		-->
		<dependency>
			<groupId>org.modelmapper</groupId>
			<artifactId>modelmapper</artifactId>
			<version>3.0.0</version>
		</dependency>
		<!--
		Spring Boot Starter Test:
		Suite di test completa contenente JUnit 5, Mockito, AssertJ e gli strumenti
		di simulazione HTTP MockMvc per convalidare lo strato dei controller.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		H2 Database (Scope Test):
		Database relazionale volatile in-memory utilizzato esclusivamente durante la suite
		di test d'integrazione per simulare in modo ultrarapido PostgreSQL.
		-->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!--
		====================================================================================
		CONFIGURAZIONE PLUGINS DI BUILD
		====================================================================================
		Configura i moduli aggiuntivi per estendere le funzionalità di Maven in fase di compilazione.
		====================================================================================
	-->
	<build>
		<plugins>
			<!--
			Spring Boot Maven Plugin:
			Si occupa di impacchettare l'applicazione in un "Fat JAR" (un archivio auto-eseguibile
			contenente tutte le dipendenze e il server Tomcat incorporato).
			Esclude esplicitamente Lombok dal build finale di produzione poiché non è più
			necessario dopo la compilazione.
			-->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>